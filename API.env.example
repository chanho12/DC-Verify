# API.env에 복사한 뒤 아래 = 뒤에 본인의 OpenAI API 키를 입력하세요.
# 실제 키가 들어간 API.env는 Git에 올리지 마세요.
OPENAI_API_KEY=

# Python 외부 검색을 사용할 때만 별도의 Tavily 키가 필요합니다.
TAVILY_API_KEY=
DC_VERIFY_DATA_DIR=./data/runtime
# 계획·Controller·반증·최종 Verifier: gpt-6.1-sol
# OCR·추출·원문/의미 검증: gpt-5.4-mini
# 근거 검색 임베딩: text-embedding-3-large
# Qdrant는 로컬 저장 모드입니다. 별도 서버나 키가 필요하지 않습니다.
# 다른 환경 파일을 쓰려면 OS 환경변수 DC_VERIFY_ENV_FILE에 경로를 설정하세요.
